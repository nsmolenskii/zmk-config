#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define MAIN 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {

  // Activate ADJUST layer by holding both LOWER and RAISE
  conditional_layers {
    compatible = "zmk,conditional-layers";
    adjust_layer {
      if-layers = <LOWER RAISE>;
      then-layer = <ADJUST>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    main_layer {
      display-name = "MAIN";
      // ------------------------------------------------------------------------------------------------------------
      // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   =   |
      // |  ESC  |  B  |  L  |  D   |  W   |  Z   |                   |  '   |  F    |  O    |  U   |   J   |   /   |
      // |  TAB  |  N  |  R  |  T   |  S   |  G   |                   |  Y   |  H    |  A    |  E   |   I   |   -   |
      // | SHIFT |  Q  |  X  |  M   |  C   |  V   |  CAPS  |  |  DEL  |  K   |  P    |  .    |  ;   |   ,   | SHIFT |
      //               | CTRL| ALT  | GUI  | RAISE|  ENTER |  | SPACE | LOWER| BKSPC | GUI   | CTRL |
      bindings = <
        &kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp EQUAL
        &kp ESC   &kp B  &kp L    &kp D    &kp W     &kp Z                            &kp SQT &kp F    &kp O     &kp U    &kp J    &kp FSLH
        &kp TAB   &kp N  &kp R    &kp T    &kp S     &kp G                            &kp Y  &kp H     &kp A     &kp E    &kp I    &kp MINUS
        &kp LSHFT &kp Q  &kp X    &kp M    &kp C     &kp V   &kp CLCK   &kp DEL       &kp K  &kp P     &kp DOT  &kp SEMI &kp COMMA &kp RSHFT
        &kp LCTRL &kp LALT &kp LGUI &mo RAISE  &kp RET    &kp SPACE  &mo LOWER  &kp BSPC &kp RGUI  &kp RCTRL
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
    };

    lower_layer {
      display-name = "LOWER";
      // Numpad on the right hand, F-keys on the left.
      // Shift over the digits gives ! @ # $ % ^ & * ( ) so they need no slots.
      // Rows 2-4 are the 3x6 block a Corne also has; row 1 is Sofle-only.
      // ------------------------------------------------------------------------------------------------------------
      // |       |      |      |      |      |     |                   |      |       |       |      |       |       |
      // |       |  F1  |  F2  |  F3  |  F4  |     |                   |      |   7   |   8   |   9  |       |       |
      // |       |  F5  |  F6  |  F7  |  F8  |     |                   |      |   4   |   5   |   6  |       |       |
      // |       |  F9  | F10  | F11  | F12  |     |        |  |       |  0   |   1   |   2   |   3  |       |       |
      //               |      |      |      |      |        |  |       |      |       |       |      |
      bindings = <
        &trans    &trans    &trans    &trans    &trans    &trans                    &trans    &trans    &trans    &trans    &trans    &trans
        &trans    &kp F1    &kp F2    &kp F3    &kp F4    &trans                    &trans    &kp N7    &kp N8    &kp N9    &trans    &trans
        &trans    &kp F5    &kp F6    &kp F7    &kp F8    &trans                    &trans    &kp N4    &kp N5    &kp N6    &trans    &trans
        &trans    &kp F9    &kp F10   &kp F11   &kp F12   &trans    &trans &trans   &kp N0    &kp N1    &kp N2    &kp N3    &trans    &trans
        &trans    &trans    &trans    &trans    &trans    &trans    &trans &trans   &trans    &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
    };

    raise_layer {
      display-name = "RAISE";
      // Left hand is everything you need while the right hand is on the mouse:
      // arrows, paging, clipboard, select-all. Left Shift falls through from
      // MAIN, so Shift+arrow selection and Shift+Cmd+Z work one-handed too.
      // Right hand is paired symbols, cross-hand from the left thumb that
      // holds the layer. Brackets sit on index and middle, opening always left.
      // ------------------------------------------------------------------------------------------------------------
      // |       |      |      |       |       |      |                |      |      |       |      |       |       |
      // |       |      | HOME |   ^   |  END  | PGUP |                |      |  {   |   }   |  +   |   -   |   \   |
      // |       | SALL |  <-  |   v   |  ->   | PGDN |                |      |  (   |   )   |  =   |   _   |   `   |
      // | SHIFT | UNDO | CUT  | COPY  | PASTE | VOL- | VOL+ |  | PREV | NEXT |  [   |   ]   |  <   |   >   |       |
      //               |     |      |      |      |  MUTE  |  |  P/P  |      |       |       |       |
      bindings = <
        &trans     &trans       &trans       &trans       &trans       &trans                            &trans    &trans    &trans    &trans     &trans     &trans
        &trans     &trans       &kp HOME     &kp UP       &kp END      &kp PG_UP                         &trans    &kp LBRC  &kp RBRC  &kp PLUS   &kp MINUS  &kp BSLH
        &trans     &kp LG(A)    &kp LEFT     &kp DOWN     &kp RIGHT    &kp PG_DN                         &trans    &kp LPAR  &kp RPAR  &kp EQUAL  &kp UNDER  &kp GRAVE
        &trans     &kp LG(Z)    &kp LG(X)    &kp LG(C)    &kp LG(V)    &kp C_VOL_DN    &kp C_VOL_UP &kp C_PREV &kp C_NEXT &kp LBKT  &kp RBKT  &kp LT     &kp GT     &trans
                                &trans       &trans       &trans       &trans          &kp C_MUTE &kp C_PP  &trans    &trans    &trans    &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
    };

    adjust_layer {
      // ----------------------------------------------------------------------------------------------------------------------------
      // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
      // | EP_OFF |         |         |         |         |         |                  |      |      |       |      |       |       |
      // |        |         |         |         |         |         |                  |      |      |       |      |       |       |
      // |        |         |         |         |         |         | STUDIO  | |      |      |      |       |      |       |       |
      //                    |         |         |         |         |         | |      |      |      |       |      |
      display-name = "ADJUST";
      bindings = <
        &bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &none &none &none &none &none &none
        &ext_power EP_OFF &none           &none           &none           &none           &none                               &none &none &none &none &none &none
        &none             &none           &none           &none           &none           &none                                   &none &none &none &none &none &none
        &none             &none           &none           &none           &none           &none            &studio_unlock  &none  &none &none &none &none &none &none
        &none           &none           &none           &none            &none           &none  &none &none &none &none
      >;
    };
  };
};
